<div id="chrono-settings-overlay" class="chrono-settings-overlay" aria-hidden="true"></div>

<aside id="chrono-settings" class="chrono-settings-panel" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="chrono-settings-title">
    <div class="chrono-settings-header">
        <h2 id="chrono-settings-title" class="chrono-settings-title">Parameter Control</h2>
        <button id="chrono-settings-close" class="chrono-settings-close" aria-label="Close Settings">×</button>
    </div>

    <!-- Location Status -->
    <div id="chrono-location-status" class="chrono-status-indicator">
        <div class="status-content">
            <span class="status-icon">Checking...</span>
            <span class="status-text">Location Access</span>
        </div>
        <button id="chrono-request-location" class="status-action" style="display:none;">Enable</button>
    </div>

    <!-- Location Selector -->
    <div class="chrono-settings-control" style="margin-bottom: 1.5rem;">
        <div class="chrono-settings-label-row">
            <label for="chrono-location-select">Location Override</label>
        </div>
        <select id="chrono-location-select" class="chrono-select">
            <option value="current">📍 Current Location</option>
            
            <optgroup label="Africa">
                <option value="6.5244,3.3792,1">Lagos (UTC+1)</option>
                <option value="30.0444,31.2357,2">Cairo (UTC+2)</option>
                <option value="-4.4419,15.2663,1">Kinshasa (UTC+1)</option>
            </optgroup>
            
            <optgroup label="Asia">
                <option value="35.6762,139.6503,9">Tokyo (UTC+9)</option>
                <option value="28.7041,77.1025,5.5">Delhi (UTC+5.5)</option>
                <option value="31.2304,121.4737,8">Shanghai (UTC+8)</option>
            </optgroup>
            
            <optgroup label="Europe">
                <option value="41.0082,28.9784,3">Istanbul (UTC+3)</option>
                <option value="55.7558,37.6173,3">Moscow (UTC+3)</option>
                <option value="51.5074,-0.1278,0">London (UTC+0)</option>
            </optgroup>
            
            <optgroup label="North America">
                <option value="19.4326,-99.1332,-6">Mexico City (UTC-6)</option>
                <option value="40.7128,-74.0060,-5">New York (UTC-5)</option>
                <option value="34.0522,-118.2437,-8">Los Angeles (UTC-8)</option>
            </optgroup>
            
            <optgroup label="South America">
                <option value="-23.5505,-46.6333,-3">São Paulo (UTC-3)</option>
                <option value="-34.6037,-58.3816,-3">Buenos Aires (UTC-3)</option>
                <option value="-22.9068,-43.1729,-3">Rio de Janeiro (UTC-3)</option>
            </optgroup>
            
            <optgroup label="Oceania">
                <option value="-33.8688,151.2093,11">Sydney (UTC+11)</option>
                <option value="-37.8136,144.9631,11">Melbourne (UTC+11)</option>
                <option value="-27.4705,153.0260,10">Brisbane (UTC+10)</option>
            </optgroup>
        </select>
    </div>

    <!-- Header / Manual Override -->
    <div class="chrono-settings-section">
        <div class="chrono-settings-row">
            <input type="checkbox" id="chrono-manual">
            <label for="chrono-manual" class="chrono-settings-label-inline">Manual Override</label>
        </div>
    </div>

    <!-- Simulation Environment -->
    <div class="chrono-settings-section">
        <h3 class="chrono-settings-subtitle">Simulation Environment</h3>
        
        <!-- Day of Year -->
        <div class="chrono-settings-control">
            <div class="chrono-settings-label-row">
                <label for="chrono-doy">Day of Year (Season)</label>
                <span id="chrono-doy-value" class="chrono-settings-value">0</span>
            </div>
            <input type="range" id="chrono-doy" min="0" max="364" step="1" value="0">
        </div>

        <!-- Time of Day -->
        <div class="chrono-settings-control">
            <div class="chrono-settings-label-row">
                <label for="chrono-time">Time of Day</label>
                <span id="chrono-time-value" class="chrono-settings-value">00:00</span>
            </div>
            <input type="range" id="chrono-time" min="0" max="1440" step="15" value="720">
        </div>
    </div>

    <!-- Color Grading -->
    <div class="chrono-settings-section">
        <h3 class="chrono-settings-subtitle">Color Grading (OKLCH)</h3>
        
        <!-- Base Hue -->
        <div class="chrono-settings-control">
            <div class="chrono-settings-label-row">
                <label for="chrono-hue-base">Base Hue (0-360)</label>
                <span id="chrono-hue-base-value" class="chrono-settings-value">260</span>
            </div>
            <input type="range" id="chrono-hue-base" min="0" max="360" step="1" value="260">
        </div>

        <!-- Secondary Hue Offset -->
        <div class="chrono-settings-control">
            <div class="chrono-settings-label-row">
                <label for="chrono-hue-sec">Sec. Hue Offset (+/- 180)</label>
                <span id="chrono-hue-sec-value" class="chrono-settings-value">40</span>
            </div>
            <input type="range" id="chrono-hue-sec" min="-180" max="180" step="5" value="-80">
        </div>
        
        <!-- Tertiary Hue Offset -->
        <div class="chrono-settings-control">
            <div class="chrono-settings-label-row">
                <label for="chrono-hue-ter">Ter. Hue Offset (+/- 180)</label>
                <span id="chrono-hue-ter-value" class="chrono-settings-value">40</span>
            </div>
            <input type="range" id="chrono-hue-ter" min="-180" max="180" step="5" value="40">
        </div>

        <!-- Lightness -->
        <div class="chrono-settings-control">
            <div class="chrono-settings-label-row">
                <label for="chrono-lightness">Lightness (0 - 1.0)</label>
                <span id="chrono-lightness-value" class="chrono-settings-value">0.05</span>
            </div>
            <input type="range" id="chrono-lightness" min="0" max="1" step="0.01" value="0.05">
        </div>

        <!-- Chroma -->
        <div class="chrono-settings-control">
            <div class="chrono-settings-label-row">
                <label for="chrono-chroma">Chroma (Vibrancy)</label>
                <span id="chrono-chroma-value" class="chrono-settings-value">0.18</span>
            </div>
            <input type="range" id="chrono-chroma" min="0" max="0.4" step="0.01" value="0.18">
        </div>
    </div>

    <!-- Atmosphere & Post-FX -->
    <div class="chrono-settings-section">
        <h3 class="chrono-settings-subtitle">Atmosphere & Post-FX</h3>
        
        <!-- Blur -->
        <div class="chrono-settings-control">
            <div class="chrono-settings-label-row">
                <label for="chrono-blur">Blur Strength (Mesh)</label>
                <span id="chrono-blur-value" class="chrono-settings-value">120px</span>
            </div>
            <input type="range" id="chrono-blur" min="0" max="200" step="5" value="120">
        </div>

        <!-- Noise -->
        <div class="chrono-settings-control">
            <div class="chrono-settings-label-row">
                <label for="chrono-noise">Noise Opacity</label>
                <span id="chrono-noise-value" class="chrono-settings-value">7%</span>
            </div>
            <input type="range" id="chrono-noise" min="0" max="0.3" step="0.01" value="0.07">
        </div>

        <!-- Saturation Boost -->
        <div class="chrono-settings-control">
            <div class="chrono-settings-label-row">
                <label for="chrono-saturation">Saturation Boost</label>
                <span id="chrono-saturation-value" class="chrono-settings-value">130%</span>
            </div>
            <input type="range" id="chrono-saturation" min="50" max="250" step="5" value="130">
        </div>
    </div>

    <!-- Kinetics -->
    <div class="chrono-settings-section">
        <h3 class="chrono-settings-subtitle">Kinetics</h3>
        
        <!-- Flow Speed -->
        <div class="chrono-settings-control">
            <div class="chrono-settings-label-row">
                <label for="chrono-speed">Flow Speed</label>
                <span id="chrono-speed-value" class="chrono-settings-value">1.0x</span>
            </div>
            <input type="range" id="chrono-speed" min="0" max="5.0" step="0.1" value="1.0">
        </div>

        <!-- Blob Scale -->
        <div class="chrono-settings-control">
            <div class="chrono-settings-label-row">
                <label for="chrono-scale">Blob Scale</label>
                <span id="chrono-scale-value" class="chrono-settings-value">1.0</span>
            </div>
            <input type="range" id="chrono-scale" min="0.5" max="2.0" step="0.1" value="1.0">
        </div>
    </div>

    <div class="chrono-settings-footer">
        <button id="chrono-reset" class="chrono-btn-reset">Reset to Defaults</button>
        <span class="chrono-version">Engine v5.0</span>
    </div>
</aside>
