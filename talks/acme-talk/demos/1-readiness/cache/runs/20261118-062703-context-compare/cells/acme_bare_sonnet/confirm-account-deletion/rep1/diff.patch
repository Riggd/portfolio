+import { useEffect, useRef, useState } from 'react';
+import '@acme/ds/foundations.css';
+import { Alert, Button } from '@acme/ds';
+
+const stack = (gap: string) => ({
+  display: 'flex',
+  flexDirection: 'column' as const,
+  gap,
+});
+
+interface ConfirmDeleteDialogProps {
+  open: boolean;
+  onCancel: () => void;
+  onConfirm: () => void;
+}
+
+/**
+ * Confirmation step for permanent account deletion. Uses a native modal
+ * <dialog> so focus is trapped and Escape cancels. The destructive action
+ * stays disabled until the user explicitly acknowledges it, and focus starts
+ * on the safe action (Cancel).
+ */
+function ConfirmDeleteDialog({ open, onCancel, onConfirm }: ConfirmDeleteDialogProps) {
+  const dialogRef = useRef<HTMLDialogElement>(null);
+  const [understood, setUnderstood] = useState(false);
+
+  useEffect(() => {
+    const dialog = dialogRef.current;
+    if (!dialog) return;
+    if (open && !dialog.open) {
+      setUnderstood(false);
+      dialog.showModal();
+      dialog.querySelector<HTMLButtonElement>('[data-initial-focus]')?.focus();
+    } else if (!open && dialog.open) {
+      dialog.close();
+    }
+  }, [open]);
+
+  return (
+    <dialog
+      ref={dialogRef}
+      aria-labelledby="delete-dialog-title"
+      aria-describedby="delete-dialog-desc"
+      onCancel={(e) => {
+        e.preventDefault();
+        onCancel();
+      }}
+      style={{
+        width: 'min(480px, calc(100vw - var(--space-6)))',
+        padding: 'var(--space-5)',
+        border: '1px solid var(--color-border-default)',
+        borderRadius: 'var(--surface-radius)',
+        background: 'var(--surface-bg)',
+        color: 'var(--color-text-primary)',
+      }}
+    >
+      <div style={stack('var(--space-4)')}>
+        <h2
+          id="delete-dialog-title"
+          style={{
+            margin: 0,
+            fontSize: 'var(--font-size-lg)',
+            fontWeight: 'var(--font-weight-semibold)',
+            lineHeight: 'var(--font-line-height-tight)',
+          }}
+        >
+          Delete your account?
+        </h2>
+
+        <div id="delete-dialog-desc">
+          <Alert intent="warning" title="This can't be undone">
+            Your profile, projects and settings will be permanently deleted. We can't restore them
+            afterwards.
+          </Alert>
+        </div>
+
+        <label
+          style={{
+            display: 'flex',
+            alignItems: 'flex-start',
+            gap: 'var(--space-2)',
+            cursor: 'pointer',
+          }}
+        >
+          <input
+            type="checkbox"
+            checked={understood}
+            onChange={(e) => setUnderstood(e.target.checked)}
+            style={{ marginTop: 'var(--space-1)' }}
+          />
+          <span>I understand that deleting my account is permanent.</span>
+        </label>
+
+        <div style={{ display: 'flex', justifyContent: 'flex-end', gap: 'var(--space-3)' }}>
+          <Button variant="secondary" onClick={onCancel} data-initial-focus="">
+            Cancel
+          </Button>
+          <Button variant="destructive" disabled={!understood} onClick={onConfirm}>
+            Delete account
+          </Button>
+        </div>
+      </div>
+    </dialog>
+  );
+}
+
 export function TaskScreen() {
-  // Implement the task here.
-  return null;
+  const [confirming, setConfirming] = useState(false);
+  const [deleted, setDeleted] = useState(false);
+
+  return (
+    <main
+      style={{
+        maxWidth: '640px',
+        margin: '0 auto',
+        padding: 'var(--space-6) var(--space-4)',
+        ...stack('var(--space-5)'),
+      }}
+    >
+      <h1
+        style={{
+          margin: 0,
+          fontSize: 'var(--font-size-xl)',
+          fontWeight: 'var(--font-weight-semibold)',
+        }}
+      >
+        Account settings
+      </h1>
+
+      {deleted ? (
+        <Alert intent="success" title="Account deleted">
+          Your account has been permanently deleted.
+        </Alert>
+      ) : (
+        <section
+          aria-labelledby="delete-section-title"
+          style={{
+            ...stack('var(--space-3)'),
+            padding: 'var(--space-5)',
+            border: '1px solid var(--color-border-default)',
+            borderRadius: 'var(--surface-radius)',
+            background: 'var(--surface-bg)',
+          }}
+        >
+          <h2
+            id="delete-section-title"
+            style={{
+              margin: 0,
+              fontSize: 'var(--font-size-lg)',
+              fontWeight: 'var(--font-weight-semibold)',
+            }}
+          >
+            Delete account
+          </h2>
+          <p style={{ margin: 0, color: 'var(--color-text-secondary)' }}>
+            Permanently delete your account and all associated data. This can't be undone.
+          </p>
+          <div>
+            <Button variant="destructive" onClick={() => setConfirming(true)}>
+              Delete account…
+            </Button>
+          </div>
+        </section>
+      )}
+
+      <ConfirmDeleteDialog
+        open={confirming}
+        onCancel={() => setConfirming(false)}
+        onConfirm={() => {
+          setConfirming(false);
+          setDeleted(true);
+        }}
+      />
+    </main>
+  );
 }
